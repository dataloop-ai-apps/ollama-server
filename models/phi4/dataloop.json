{
    "name": "ollama-server-phi4",
    "displayName": "Ollama Server - Phi4",
    "version": "1.0.3",
    "scope": "public",
    "attributes": {
        "Category": [
          "Application"
        ],
        "Provider": "Ollama",
        "Application Type": "Model",
        "License": "MIT"
      },
    "description": "Local LLM inference via Ollama",
    "components": {
        "panels": [
            {
                "name": "ollama",
                "supportedSlots": [
                ],
                "conditions": {}
            }
        ],
        "modules": [
            {
                "name": "ollama-module",
                "entryPoint": "runner.py",
                "className": "Runner",
                "initInputs": [],
                "config": {
                    "isCustomServer": true
                },
                "functions": [
                    {
                        "name": "dummy",
                        "output": [],
                        "input": []
                    }
                ]
            }
        ],
        "services": [
            {
                "name": "ollama-service-phi4",
                "displayName": "Ollama Server - Phi4",
                "moduleName": "ollama-module",
                "panelNames": ["ollama"],
                "initParams": {},
                "runtime": {
                    "podType": "highmem-m",
                    "numReplicas": 1,
                    "concurrency": 10,
                    "runnerImage": "gcr.io/viewo-g/piper/agent/runner/apps/ollama-server:phi4-mini-1.0.0",                    
                    "singleAgent": false,
                    "autoscaler": {
                        "type": "rabbitmq",
                        "minReplicas": 1,
                        "maxReplicas": 1,
                        "queueLength": 1
                    },
                    "preemptible": false
                },
                "drainTime": 600,
                "onReset": "failed",
                "runExecutionAsProcess": false,
                "executionTimeout": 3600,
                "maxAttempts": 3
            }
        ],
        "metadata": [
            {
                "model": "phi4",
                "contextWindow": 16000,
                "maxOutputTokens": 16000,
                "capabilities": {
                    "chat": true,
                    "embeddings": false,
                    "functionCalling": false,
                    "vision": false,
                    "streaming": false
                }
            }
    ]
    }
}
